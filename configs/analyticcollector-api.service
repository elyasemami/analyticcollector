[Unit]
Description=analyticcollector API (Express + MongoDB monolith)
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
WorkingDirectory=/var/www/eemami.dev/api
EnvironmentFile=/var/www/eemami.dev/api/.env
ExecStart=/usr/bin/node /var/www/eemami.dev/api/server.js
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data

# Only bound to 127.0.0.1:PORT by server.js — never exposed directly,
# nginx is the only thing that talks to it (see configs/nginx-eemami.dev.conf).
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
